\geometry{a4paper, left=2.5cm, right=2.5cm, top=3cm, bottom=3cm, headheight=15pt}

% =============================================
% 页眉页脚设置
% =============================================
\pagestyle{fancy}
\fancyhf{}
\lhead{\textbf{数值分析}}
\chead{\textbf{第3章数值作业}}
\rhead{\textbf{3120250024 李融冰}}
\cfoot{\thepage}

\renewcommand{\headrulewidth}{0.4pt}
