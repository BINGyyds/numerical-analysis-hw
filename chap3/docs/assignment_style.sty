% =============================================
% 自定义环境
% =============================================
\newenvironment{problem}[1]
    {\vspace{1em}\noindent\textbf{#1}\par\vspace{0.5em}}
    {}

\newenvironment{solution}
    {\noindent\textbf{解：}}
    {\vspace{1.5em}}

\newenvironment{myproof}
    {\noindent\textbf{证明：}}
    {\vspace{1.5em}}

